+#[test]
+fn korean_locales_resolve() {
+    // `ko-KR` is what Windows reports on a Korean PC; `ko_KR.UTF-8` is the POSIX form.
+    for tag in ["ko", "ko-KR", "ko_KR.UTF-8", "ko_KR.utf8", "KO_kr", "ko-KP", "ko-Kore-KR", "ko-Hang-KR"] {
+        assert_eq!(lang_from_tag(tag), Some(Lang::KO), "{tag}");
+    }
