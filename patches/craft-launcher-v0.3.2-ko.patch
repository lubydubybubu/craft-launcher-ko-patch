+    assert_eq!(Lang::from_pref("ko"), Lang::KO);
+    assert_eq!(super::detect::first_supported(["xx-XX", "ko-KR", "en-US"]), Some(Lang::KO));
+    assert_eq!(Lang::KO.script(), Some(super::Script::Korean));
+    assert_eq!(Lang::ZH_CN.script(), Some(super::Script::Chinese));
+    assert!(Lang::KO.needs_cjk_font() && Lang::KO.complete_menus());
