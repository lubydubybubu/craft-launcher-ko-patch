+
+#[test]
+fn korean_counts_dates_and_messages_work() {
+    // Korean nouns don't inflect for number: one form, counter after the number.
+    for n in [0, 1, 2, 11, 100] {
+        assert_eq!(trn(Lang::KO, n, "{n} app", "{n} apps"), format!("앱 {n}개"));
+        assert_eq!(trn(Lang::KO, n, "{n} day ago", "{n} days ago"), format!("{n}일 전"));
+        assert_eq!(trn(Lang::KO, n, "{n} min ago", "{n} min ago"), format!("{n}분 전"));
+    }
+    assert_eq!(trn(Lang::KO, 2, "{n} unknown item", "{n} unknown items"), "2 unknown items");
+    assert_eq!(tr(Lang::KO, "Untranslated diagnostic"), "Untranslated diagnostic");
+    assert_eq!(super::tr_ctx(Lang::KO, "month", "Mar"), "3월");
+    assert_eq!(tr(Lang::KO, "{month} {day}, {year}"), "{year}년 {month} {day}일");
+    // Launching an app is 실행; menus and buttons are short nouns.
+    assert_eq!(tr(Lang::KO, "Open"), "실행");
+    assert_eq!(tr(Lang::KO, "Install"), "설치");
+    assert_eq!(tr(Lang::KO, "Uninstall"), "제거");
+    assert_eq!(tr(Lang::KO, "Release notes"), "릴리스 노트");
+    assert_eq!(super::tr_id(Lang::KO, "app.open", "Open"), "실행");
+    // Status messages are whole sentences in 합니다체, placeholders carried over.
+    assert_eq!(message(Lang::KO, "PhotoCraft updated to 0.5.0"), "PhotoCraft 앱을 0.5.0 버전으로 업데이트했습니다.");
+    assert_eq!(message(Lang::KO, "PhotoCraft was removed"), "PhotoCraft 앱을 제거했습니다.");
+    assert_eq!(message(Lang::KO, "Couldn't open PhotoCraft: not found"), "PhotoCraft 앱을 열 수 없습니다: not found");
+}
+
+/// The Korean catalog has every row the most complete existing catalog has (in fact every row any
+/// other catalog has), so nothing that is translated elsewhere falls back to English in Korean.
+#[test]
+fn korean_catalog_has_every_row_of_the_other_catalogs() {
+    let keys = |lang: &LangInfo| -> BTreeSet<(String, String)> {
+        rows(lang).into_iter().map(|(_, context, source, _)| (context.to_string(), source.to_string())).collect()
+    };
+    let korean = keys(Lang::KO.0);
+    for other in catalogs().filter(|l| l.code != "ko") {
+        let missing: Vec<_> = keys(other).difference(&korean).cloned().collect();
+        assert!(missing.is_empty(), "ko is missing rows that {} has: {missing:#?}", other.code);
+    }
+}
+
+/// Korean text stays in Hangul (plus Latin, digits and punctuation): no Hanja or kana, which the
+/// Korean system faces aren't chosen for.
+#[test]
+fn korean_catalog_uses_no_han_or_kana() {
+    for (line, _, _, translation) in rows(Lang::KO.0) {
+        let odd: Vec<char> = translation.chars().filter(|c| ('\u{3040}'..='\u{30ff}').contains(c) || ('\u{3400}'..='\u{9fff}').contains(c)).collect();
+        assert!(odd.is_empty(), "ko line {line}: {odd:?} in {translation:?}");
+    }
+}
+
+/// The Hangul the Korean catalog uses: syllables, jamo and compatibility jamo.
+fn korean_hangul() -> String {
+    let mut chars: Vec<char> = rows(Lang::KO.0)
+        .into_iter()
+        .flat_map(|(_, _, _, translation)| translation.chars())
+        .filter(|c| ('\u{1100}'..='\u{11ff}').contains(c) || ('\u{3130}'..='\u{318f}').contains(c) || ('\u{ac00}'..='\u{d7a3}').contains(c))
+        .collect();
+    chars.sort_unstable();
+    chars.dedup();
+    chars.into_iter().collect()
+}
+
+/// With a system Korean font installed, every UI family can draw every Hangul syllable the Korean
+/// catalog uses. Machines without one (CI, the web) skip this; the UI then stays in English.
+#[test]
+fn system_font_covers_korean_in_every_ui_family() {
+    use egui::{FontFamily, FontId};
+    let text = korean_hangul();
+    assert!(text.chars().count() > 200, "only {} distinct Hangul characters", text.chars().count());
+    if !crate::theme::cjk_font_available(Lang::KO) {
+        eprintln!("skipped: no system Korean font (Malgun Gothic, Apple SD Gothic Neo, Noto Sans CJK KR, NanumGothic…) on this machine");
+        return;
+    }
+    let ctx = egui::Context::default();
+    crate::theme::install_fonts(&ctx, Some(Lang::KO));
+    let mut output = ctx.run_ui(egui::RawInput::default(), |_| {});
+    output.textures_delta.clear();
+    for family in [
+        FontFamily::Proportional,
+        FontFamily::Monospace,
+        crate::theme::medium(),
+        crate::theme::semibold(),
+        crate::theme::display(),
+        crate::theme::mono(),
+        crate::theme::mono_bold(),
+    ] {
+        ctx.fonts_mut(|fonts| {
+            let font = FontId::new(14.0, family.clone());
+            let missing: String = text.chars().filter(|c| !fonts.has_glyphs(&font, &c.to_string())).collect();
+            assert!(missing.is_empty(), "no glyph in {family:?} for {missing:?}");
+        });
+    }
+}
